pipeline {
    agent any

    environment {
        AWS_REGION    = 'ap-northeast-1'
        EKS_CLUSTER   = 'med-erp-dev-eks'
        K8S_NAMESPACE = 'med-erp'
        AWS_ACCOUNT   = '254201323767'
        ECR_REGISTRY  = "${AWS_ACCOUNT}.dkr.ecr.${AWS_REGION}.amazonaws.com"
        IMAGE_TAG     = "${env.GIT_COMMIT ? env.GIT_COMMIT.take(8) : "b${env.BUILD_NUMBER}"}"
    }

    options {
        timeout(time: 45, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '20'))
        disableConcurrentBuilds()
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('AWS & Kubernetes Check') {
            steps {
                sh '''
                    set -e

                    echo "=== AWS Identity ==="
                    aws sts get-caller-identity

                    echo "=== EKS Cluster ==="
                    aws eks describe-cluster \
                      --name "$EKS_CLUSTER" \
                      --region "$AWS_REGION" \
                      --query 'cluster.status' \
                      --output text

                    echo "=== Kubernetes Nodes ==="
                    kubectl get nodes

                    echo "=== Kubernetes Namespace ==="
                    kubectl get namespace "$K8S_NAMESPACE"
                '''
            }
        }

        stage('Build & Test') {
            steps {
                sh '''
                    set -e

                    for svc in user-service product-service order-service; do
                        echo "========================================"
                        echo "Building $svc"
                        echo "========================================"

                        cd "$WORKSPACE/$svc"
                        mvn -B clean verify
                    done
                '''
            }

            post {
                always {
                    junit allowEmptyResults: true,
                          testResults: '**/target/surefire-reports/*.xml'
                }
            }
        }

        stage('ECR Login') {
            steps {
                sh '''
                    set -e

                    echo "Logging into ECR..."

                    aws ecr get-login-password \
                      --region "$AWS_REGION" | \
                    docker login \
                      --username AWS \
                      --password-stdin "$ECR_REGISTRY"
                '''
            }
        }

        stage('Build & Push Docker Images') {
            steps {
                sh '''
                    set -e

                    for svc in user-service product-service order-service; do

                        case "$svc" in
                            user-service)
                                REPO="medical-erp-user"
                                ;;
                            product-service)
                                REPO="medical-erp-product"
                                ;;
                            order-service)
                                REPO="medical-erp-order"
                                ;;
                        esac

                        IMAGE="$ECR_REGISTRY/$REPO:$IMAGE_TAG"

                        echo "========================================"
                        echo "Building $svc"
                        echo "Repository: $REPO"
                        echo "Tag: $IMAGE_TAG"
                        echo "========================================"

                        docker build \
                          -t "$IMAGE" \
                          "$WORKSPACE/$svc"

                        docker push "$IMAGE"

                    done
                '''
            }
        }

        stage('Deploy to EKS') {
            steps {
                sh '''
                    set -e

                    echo "Using EKS cluster:"
                    kubectl config current-context

                    for svc in user-service product-service order-service; do

                        case "$svc" in
                            user-service)
                                REPO="medical-erp-user"
                                ;;
                            product-service)
                                REPO="medical-erp-product"
                                ;;
                            order-service)
                                REPO="medical-erp-order"
                                ;;
                        esac

                        IMAGE="$ECR_REGISTRY/$REPO:$IMAGE_TAG"

                        echo "Deploying $svc"
                        echo "Image: $IMAGE"

                        kubectl set image \
                          "deployment/$svc" \
                          "$svc=$IMAGE" \
                          -n "$K8S_NAMESPACE"

                        kubectl rollout status \
                          "deployment/$svc" \
                          -n "$K8S_NAMESPACE" \
                          --timeout=5m

                    done
                '''
            }
        }

        stage('Deployment Verification') {
            steps {
                sh '''
                    set -e

                    echo "=== Deployments ==="

                    kubectl get deployments \
                      -n "$K8S_NAMESPACE" \
                      -o wide

                    echo "=== Pods ==="

                    kubectl get pods \
                      -n "$K8S_NAMESPACE" \
                      -o wide
                '''
            }
        }
    }

    post {
        success {
            echo "MedERP backend CI/CD completed successfully."
        }

        failure {
            echo "MedERP backend CI/CD failed. Check the stage logs."
        }

        always {
            cleanWs()
        }
    }
}
