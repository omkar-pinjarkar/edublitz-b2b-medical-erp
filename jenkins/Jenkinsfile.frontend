pipeline {
    agent any

    environment {
        AWS_REGION              = 'ap-northeast-1'
        S3_BUCKET_NAME          = 'edublitz-medical-erp-frontend-2026-omkar'
        CLOUDFRONT_DISTRIBUTION = 'E2QDW2OZZYNT2S'
    }

    options {
        timeout(time: 20, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '10'))
        disableConcurrentBuilds()
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('AWS Check') {
            steps {
                sh '''
                    set -e

                    echo "=== AWS Identity ==="
                    aws sts get-caller-identity

                    echo "=== S3 Bucket ==="
                    aws s3api head-bucket \
                      --bucket "$S3_BUCKET_NAME"

                    echo "=== CloudFront Distribution ==="
                    aws cloudfront get-distribution \
                      --id "$CLOUDFRONT_DISTRIBUTION" \
                      --query 'Distribution.Status' \
                      --output text
                '''
            }
        }

        stage('Build Frontend') {
            steps {
                dir('frontend') {
                    sh '''
                        set -e

                        echo "=== Installing dependencies ==="
                        npm ci

                        echo "=== Running lint ==="
                        npm run lint

                        echo "=== Building frontend ==="
                        npm run build
                    '''
                }
            }
        }

        stage('Deploy to S3') {
            steps {
                dir('frontend') {
                    sh '''
                        set -e

                        echo "=== Uploading frontend to S3 ==="

                        aws s3 sync dist/ \
                          "s3://$S3_BUCKET_NAME/" \
                          --region "$AWS_REGION" \
                          --delete \
                          --cache-control "public,max-age=31536000,immutable" \
                          --exclude "*.html"

                        aws s3 cp dist/index.html \
                          "s3://$S3_BUCKET_NAME/index.html" \
                          --region "$AWS_REGION" \
                          --cache-control "no-cache,no-store,must-revalidate" \
                          --content-type "text/html"
                    '''
                }
            }
        }

        stage('CloudFront Invalidation') {
            steps {
                sh '''
                    set -e

                    echo "=== Creating CloudFront invalidation ==="

                    aws cloudfront create-invalidation \
                      --distribution-id "$CLOUDFRONT_DISTRIBUTION" \
                      --paths "/*"
                '''
            }
        }

        stage('Deployment Verification') {
            steps {
                sh '''
                    set -e

                    echo "=== S3 objects ==="
                    aws s3 ls "s3://$S3_BUCKET_NAME/" \
                      --region "$AWS_REGION" \
                      | head -20

                    echo "=== CloudFront status ==="
                    aws cloudfront get-distribution \
                      --id "$CLOUDFRONT_DISTRIBUTION" \
                      --query 'Distribution.Status' \
                      --output text

                    echo "Frontend deployment completed."
                '''
            }
        }
    }

    post {
        success {
            echo "MedERP frontend CI/CD completed successfully."
        }

        failure {
            echo "MedERP frontend CI/CD failed. Check the stage logs."
        }

        always {
            cleanWs()
        }
    }
}
